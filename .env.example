# ================================================================
# Global Effect Nexus — Plantilla de variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# ================================================================

# --- Conexión PostgreSQL (Supabase) ---
# Conexión directa para migraciones, scripts y la capa de datos (pg).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
PGHOST="db.[PROJECT_REF].supabase.co"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="[PASSWORD]"

# --- Supabase (Auth + Storage) ---
# La clave publicable (anon) se usa en el cliente (Auth/Storage).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[PUBLISHABLE_KEY]"
# La clave secreta (service role) solo en el servidor (Admin API: invitar usuarios).
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="[SECRET_KEY]"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
# Bucket de Storage para documentos/expedientes.
SUPABASE_STORAGE_BUCKET="documentos"

# --- Admin maestro (solo para `npm run db:admin`) ---
# Primera cuenta del sistema: crea el perfil super_admin y su identidad de Auth.
# Sin contraseña, el script genera un enlace de invitación (recomendado en producción).
ADMIN_MAESTRO_EMAIL="admin@globaleffect.org"
ADMIN_MAESTRO_NOMBRE="Nombre Apellido"
# ADMIN_MAESTRO_PASSWORD="[solo si se quiere la cuenta lista sin invitación]"

# --- Integraciones ---
# Resend (envío de correos: notificaciones de tareas, patrocinadores).
RESEND_API_KEY="[RESEND_API_KEY]"
RESEND_FROM="Global Effect <noreply@globaleffect.org>"
# n8n (webhooks de CRM/notificaciones).
N8N_WEBHOOK_URL="https://[N8N_HOST]/webhook/global-effect"
# Anthropic (traducción IA, OCR, asistentes de chat).
ANTHROPIC_API_KEY="[ANTHROPIC_API_KEY]"
ANTHROPIC_MODEL="claude-sonnet-5"
