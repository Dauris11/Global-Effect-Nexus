  camas integer [default: `0`]
  quienes_duermen_cama text
  direccion text
  comunidad text
  ciudad_residencia text
  pais_residencia text [default: `'República Dominicana'`]
  Note: 'Condiciones de vivienda (1:1)'
}

Table perfil_salud {
  estudiante_id uuid [pk]
  enfermedades text
  alergias text
  contacto_emergencia_nombre text
  contacto_emergencia_telefono text
  Note: 'Salud y emergencias (1:1)'
}

Table perfil_socioeconomico {
