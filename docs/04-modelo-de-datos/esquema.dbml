  leida boolean [not null, default: `false`]
  enlace text
  created_at timestamptz [not null, default: `now()`]
  Note: 'Notificaciones internas'
}

Table audit_log {
  id uuid [pk, default: `gen_random_uuid()`]
  usuario_id uuid
  accion text [not null]
  entidad text [not null]
