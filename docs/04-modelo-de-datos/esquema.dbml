  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  metadata jsonb [not null, default: `'{}'`]
  Note: 'Patrocinadores de la fundacion'
}

// ---- Estudiantes ----
Table estudiante {
  id uuid [pk, default: `gen_random_uuid()`]
  nombre text [not null]
  cedula text [unique]
  email citext
  telefono text
  fecha_nacimiento date
  lugar_nacimiento text
  nacionalidad text [default: `'Dominicana'`]
  genero genero
  sexo_documento text
  religion text
  foto_id uuid
  tipo tipo_estudiante [not null, default: `'regular'`]
  estado estado_estudiante [not null, default: `'activo'`]
  programa text
  donde_estudia text
  universidad text
  fecha_ingreso date
  patrocinador_id uuid
  facilitador_habitudes text
  centro_educativo text
  director_centro text
  imagen_habitudes_id uuid
  breve_historia_habitudes text
  amonestaciones text
  solicitudes_pendientes text
  envio_correo_patrocinador text [default: `'pendiente'`]
  asistio_reunion_mensual text [default: `'no'`]
  expediente_id uuid
  notas_adicionales text
  usuario_id uuid [unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  metadata jsonb [not null, default: `'{}'`]
  Note: 'Nucleo del expediente estudiantil'
}

Table familiar {
  id uuid [pk, default: `gen_random_uuid()`]
  estudiante_id uuid [not null]
  parentesco parentesco [not null]
  nombre text [not null]
  edad integer
  telefono text
  profesion text
  Note: 'Familiares del estudiante (1:N)'
}

Table perfil_vivienda {
  estudiante_id uuid [pk]
  con_quien_vive text
